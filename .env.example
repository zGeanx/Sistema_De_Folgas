DEBUG=True
# Defina SECRET_KEY manualmente com uma chave aleatória; ela é obrigatória no Docker.
DJANGO_SETTINGS_MODULE=config.settings.development

# PostgreSQL para produção/Render: use a Internal Database URL fornecida pelo Render.
DATABASE_URL=postgresql://folgas_user:troque-esta-senha-local@localhost:5432/folgas_db

# Docker/PostgreSQL local (use valores únicos fora do repositório)
POSTGRES_DB=folgas_db
POSTGRES_USER=folgas_user
POSTGRES_PASSWORD=troque-esta-senha-local

ALLOWED_HOSTS=localhost,127.0.0.1

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

JWT_ACCESS_TOKEN_LIFETIME=60
JWT_REFRESH_TOKEN_LIFETIME=1440


